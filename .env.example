# =============================================================================
#  LinTest secrets template
# -----------------------------------------------------------------------------
#  Copy to .env next to the installation (install.sh does this for you) and
#  fill in the values.  The file must NEVER be committed to git (it is in
#  .gitignore).
#
#  Format: one NAME=value per line.  Lines starting with '#' are comments.
#  The file is read by systemd (EnvironmentFile=) AND sourced by the cron
#  fallback, so keep values free of spaces and shell metacharacters.
# =============================================================================

# 1) Create the bot: talk to @BotFather on Telegram -> /newbot -> copy token.
LINTEST_TELEGRAM_TOKEN=123456789:AAE_your_bot_token_here

# 2) Get your chat id: message your bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and read
#    "chat":{"id": ...}  (or use @userinfobot).
LINTEST_TELEGRAM_CHAT_ID=000000000

# Optional: override where cooldown/recovery state is stored.
# LINTEST_STATE_FILE=/var/lib/lintest/state.json
